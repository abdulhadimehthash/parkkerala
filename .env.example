PORT=3001
NODE_ENV=development
BUS_STOP_TARGET_INTERVAL_SECONDS=30
BUS_DWELL_SECONDS=8
VEHICLE_RESPAWN_SECONDS=180
# Optional TURN relay configuration; set real values only in private environment settings.
# TURN_URL=turns:relay.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Alternative: Cloudflare Realtime TURN. Keep both values in Render secrets.
# The server exchanges these for temporary credentials for joined players.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Local automated tests only. Always disabled in production.
# ALLOW_TEST_TOOLS=1
