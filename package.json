{
  "name": "park-kerala",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n game,web \"node --watch server/index.js\" \"vite --host 0.0.0.0 --port 3000\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "start": "node server/index.js",
    "test:server": "node --test tests/server.test.js",
    "format": "prettier --write src shared server tests"
  },
  "dependencies": {
    "express": "^5.2.1",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
